{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/san-francisco", "destination": "/garage-cleanout", "permanent": true },
    { "source": "/before-after", "destination": "/garage-cleanout", "permanent": true },
    { "source": "/index", "destination": "/", "permanent": true }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/img/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000" }]
    }
  ]
}
